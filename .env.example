# Local values come from `npx supabase status`. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Password of the demo sign-ins (server only)
DEMO_PASSWORD=crewbase-demo
# Outgoing email for sale confirmation links. Locally this is Supabase's test mailbox
# (read the messages at http://127.0.0.1:54324). Leave SMTP_HOST empty to show links on screen only.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Crewbase <no-reply@crewbase.example>
APP_URL=http://localhost:3100
